# Copy this to .env (or .env.dev / .env.qual / .env.prod) and update values
NODE_ENV=development
DATABASE_URL="file:/app/data/dev.db"
# Auth.js session secret (JWT_SECRET is accepted as a fallback)
AUTH_SECRET="change-this-to-a-secure-random-string"
ADMIN_EMAIL="admin@barks-a-lot.com"
ADMIN_PASSWORD="change-this-admin-password-1"
PORT=3000
# Optional: enables address autofill + embedded maps on event pages.
# Without it, location stays a plain text field and maps become links.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Optional: real email delivery for verification emails via Resend.
# Without it, emails are logged to the server console (dev only).
RESEND_API_KEY=""
# Use "Barks-A-Lot <onboarding@resend.dev>" until your domain is verified in Resend
EMAIL_FROM="Barks-A-Lot <noreply@barks-a-lot.com>"
# Public base URL used in emailed links (falls back to the request origin)
APP_URL=""
