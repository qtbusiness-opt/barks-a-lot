# Copy this to .env (or .env.dev / .env.qual / .env.prod) and update values
NODE_ENV=development
DATABASE_URL="file:/app/data/dev.db"
# Auth.js session secret (JWT_SECRET is accepted as a fallback)
AUTH_SECRET="change-this-to-a-secure-random-string"
ADMIN_EMAIL="admin@barks-a-lot.com"
ADMIN_PASSWORD="change-this-admin-password-1"
PORT=3000
# Optional: enables address autofill + embedded maps on event pages.
# Without it, location stays a plain text field and maps become links.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Optional: real email delivery for verification emails via Resend.
# Without it, emails are logged to the server console (dev only).
RESEND_API_KEY=""
# Use "Barks-A-Lot <onboarding@resend.dev>" until your domain is verified in Resend
EMAIL_FROM="Barks-A-Lot <noreply@barks-a-lot.com>"
# Public base URL used in emailed links (falls back to the request origin)
APP_URL=""
# Square payments. The app id is public (browser-side card tokenization);
# use the sandbox-... id while testing, your production id at launch.
# Without an app id the checkout skips the card form and the server skips
# charging (dev/test mode).
NEXT_PUBLIC_SQUARE_APP_ID=""
# Recommended: your Square location id. IMPORTANT: sandbox and production
# have DIFFERENT location ids — while SQUARE_ENV is sandbox this must be a
# SANDBOX location id (Developer Dashboard -> open the sandbox test
# account -> Locations, or list them with:
#   curl https://connect.squareupsandbox.com/v2/locations \
#     -H "Authorization: Bearer $SQUARE_ACCESS_TOKEN").
# A production location id with a sandbox app id makes card tokenization
# fail in the payment form.
NEXT_PUBLIC_SQUARE_LOCATION_ID=""
# SECRET server-side access token — never expose to the browser or commit.
SQUARE_ACCESS_TOKEN=""
# "sandbox" (default) or "production" — picks the Square API endpoint.
SQUARE_ENV="sandbox"
# Store timezone — event times ("HH:MM") are wall-clock in this zone, and
# the same-day pickup cutoff is computed against it. Set it in production
# so the container's clock matches your markets.
TZ="America/Boise"
