# Copy this to .env (or .env.dev / .env.qual / .env.prod) and update values
NODE_ENV=development
DATABASE_URL="file:/app/data/dev.db"
# Auth.js session secret (JWT_SECRET is accepted as a fallback)
AUTH_SECRET="change-this-to-a-secure-random-string"
ADMIN_EMAIL="admin@barks-a-lot.com"
ADMIN_PASSWORD="change-this-admin-password"
PORT=3000
# Optional: enables address autofill + embedded maps on event pages.
# Without it, location stays a plain text field and maps become links.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
