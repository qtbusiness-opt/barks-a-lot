generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  role          String    @default("customer")
  // Set when the customer clicks their verification link; unverified
  // customers cannot sign in.
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]
  verificationTokens VerificationToken[]
  addresses     Address[]
}

// A customer's address book. Entries are auto-captured from shipping
// orders (deduplicated) and can be edited or deleted — order records
// themselves keep their original address untouched.
model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address   String
  city      String
  state     String
  zip       String
  createdAt DateTime @default(now())
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // sha256 of the emailed token — the raw value never touches the DB.
  tokenHash String   @unique
  // "verify" (email verification) | "reset" (password reset)
  purpose   String   @default("verify")
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Product {
  id          String      @id @default(cuid())
  name        String
  // URL-friendly form of the name, used for /products/<slug>. Kept
  // optional so a row can never be blocked on it; the detail route still
  // resolves a bare id, which keeps old links and order history working.
  slug        String?     @unique
  description String
  // Stock for products without variants; for products with variants the
  // stock lives on each variant and this stays 0.
  quantity    Int
  price       Float
  // When true, stock lives on this product's option combinations
  // (ProductVariant rows linked via ProductVariantChoice) instead of on
  // `quantity` directly. Explicit rather than inferred from
  // variants.length, so a product can start with an empty variant list
  // and still declare its stock model.
  trackOptionStock Boolean @default(false)
  // Cover image, shown on cards/cart/orders. Additional gallery images
  // live in `images` as a JSON-encoded array of URLs; the detail page
  // shows [image, ...images].
  image       String
  images      String?
  // Ingredients for treats/food, general item details for everything
  // else — the label is chosen by category in the UI.
  itemDetails String?
  // Nutrition facts for edible products, as a JSON-encoded array of
  // {label, value} rows (e.g. [{"label":"Crude Protein (min)",
  // "value":"24%"}]) rendered as a table on the product page. Only
  // offered for categories with showsIngredients — same gate as the
  // Ingredients section, so "edible" stays one admin-managed flag
  // rather than a hardcoded category name.
  nutritionFacts String?
  category    String
  inStock     Boolean     @default(true)
  featured    Boolean     @default(false)
  // Limited/seasonal drops (e.g. holiday plushie "adoptions"):
  // limitedQuantity is the original batch size so the UI can show
  // "X of Y left"; sold-out limited items are hidden from listings.
  limitedQuantity Int?
  availableFrom   DateTime?
  availableUntil  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  variants    ProductVariant[]
  optionGroups ProductOptionGroup[]
  orderItems  OrderItem[]
}

// A set of choices the customer picks from on the product page — e.g. a
// bandana's "Size" and "Style" are two separate groups. Distinct from
// ProductVariant: variants carry their own price and stock, while option
// groups are selections recorded on the order (no price or stock of
// their own), so a product can have several without multiplying SKUs.
model ProductOptionGroup {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  // How the choices are presented: "select" (dropdown), "carousel"
  // (thumbnails the customer clicks through), "radio", or "checkbox".
  // Only checkbox groups accept more than one selection.
  inputType String   @default("radio")
  // When true the customer must answer before adding to the cart.
  required  Boolean  @default(true)
  // At most one group per product may be true. Its choices' `price`
  // becomes the product's price once trackOptionStock is on — e.g. a
  // bandana's Size group sets price while Style only affects stock.
  // Enforced in the write path (src/lib/option-writes.js), not the DB.
  setsPrice Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  choices   ProductOptionChoice[]

  @@index([productId])
}

model ProductOptionChoice {
  id        String   @id @default(cuid())
  groupId   String
  group     ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  label     String
  // Thumbnail for "carousel" groups; ignored by the other input types.
  image     String?
  // Only meaningful when the parent group is the pricing group
  // (setsPrice). Absolute price for this choice — not an adjustment.
  price     Float?
  sortOrder Int      @default(0)
  // Set instead of deleting when this choice still anchors an archived
  // combination with order history — ProductVariantChoice.choice is ON
  // DELETE RESTRICT specifically so that case can't be hard-deleted.
  // Archived choices are excluded from admin editing and the storefront.
  archivedAt DateTime?
  variantChoices ProductVariantChoice[]

  @@index([groupId])
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  // Auto-generated from its choices' labels (e.g. "Small / Plaid") for
  // trackOptionStock products; hand-entered otherwise (legacy variants
  // with no linked choices).
  name       String
  // null = inherit the product's base price. For a trackOptionStock
  // product this is normally left null — price comes from the pricing
  // group's choice instead (see ProductOptionChoice.price).
  price      Float?
  quantity   Int      @default(0)
  // A combination with order history is archived rather than deleted
  // when its choices change, since OrderItem.variantId is ON DELETE SET
  // NULL — deleting it would silently detach past orders from what was
  // actually bought. Archived combinations are excluded from stock and
  // from the storefront.
  archivedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orderItems OrderItem[]
  // The set of choices (one per participating option group) that
  // defines this combination. Empty for a legacy hand-named variant.
  choices    ProductVariantChoice[]

  @@index([productId])
}

// Links a combination (ProductVariant) to the specific choice it picked
// from each participating option group — e.g. {Size: Medium} +
// {Style: Plaid}. One row per (variant, group) pair.
model ProductVariantChoice {
  id        String              @id @default(cuid())
  variantId String
  variant   ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  choiceId  String
  // Restrict, not Cascade: deleting a choice that still anchors a live
  // combination should fail loudly rather than silently dissolve the
  // combination and its stock. The write path archives the combination
  // first when a choice is actually being removed.
  choice    ProductOptionChoice @relation(fields: [choiceId], references: [id], onDelete: Restrict)

  @@unique([variantId, choiceId])
  @@index([choiceId])
}

model Order {
  id                 String      @id @default(cuid())
  confirmationNumber String      @unique
  userId             String?
  user               User?       @relation(fields: [userId], references: [id])
  guestEmail         String?
  guestName          String?
  status             String      @default("pending")
  // "online" (web checkout) | "market" (in-person sale recorded after the
  // fact) — one inventory ledger across both sales channels.
  channel            String      @default("online")
  // "shipping" | "pickup" — pickup orders (markets/expos) need no address.
  fulfillmentType    String      @default("shipping")
  // The market/expo the customer chose to pick up at.
  pickupEventId      String?
  pickupEvent        Event?      @relation(fields: [pickupEventId], references: [id])
  total              Float
  // Square payment id for the charge — the only payment detail we store
  // (never card numbers). Null when payments aren't configured (dev) or
  // for market sales recorded after the fact.
  paymentId          String?
  // Bookkeeping-only flag an admin toggles on a picked-up order (e.g. a
  // post-pickup return). Does not trigger a Square refund or restock.
  refunded           Boolean     @default(false)
  // Total discount applied from promotions (bundles + code); `total` is
  // already net of it. promoCode records the code entered, if any.
  discountTotal      Float       @default(0)
  promoCode          String?
  address            String?
  city               String?
  state              String?
  zip                String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  items              OrderItem[]
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id])
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int
  price     Float
  // The option-group answers for this line, JSON-encoded as
  // [{"group":"Size","values":["Large"]}]. Stored as a snapshot of the
  // labels, so renaming or deleting an option later can't rewrite what
  // the customer actually ordered.
  options   String?
  // The photo this line was bought as: the chosen option's own picture
  // when it has one (the bandana pattern the customer clicked), else the
  // product's cover at the time of the order. A snapshot for the same
  // reason as `options` above — replacing a product photo or retiring an
  // option must not change what a past order looks like. Resolved
  // server-side from the stored choice, never accepted from the browser.
  // Null on orders placed before this column existed; readers fall back
  // to the product's current cover.
  image     String?
}

// Product categories, managed by admins. Products reference the slug as
// a plain string (Product.category) — deletion is blocked while any
// product still uses the slug, and slug renames cascade to products.
model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  // Emoji shown on the homepage tile.
  icon      String   @default("🐾")
  // When true, products in this category show an "Ingredients" section
  // on their detail page (always visible); otherwise the section is
  // labeled "Item Details" and only appears when filled in.
  showsIngredients Boolean @default(false)
  createdAt DateTime @default(now())
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  // Admin who created it, for the audit trail.
  createdBy String
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  // Customer or guest email the notification is addressed to.
  email     String
  message   String
  orderId   String?
  // Set when an admin archives it off the active notifications list.
  archivedAt DateTime?
  createdAt DateTime @default(now())
}

// Admin-managed promotions. Two kinds:
//  - "code": a percent-off coupon activated by entering `code` at
//    checkout (e.g. "VETERANS" → 20% off).
//  - "bundle": automatic mix-and-match pricing — buy `bundleQuantity` of
//    any products in `productIds` for `bundlePrice` (e.g. any 2 of
//    {biscuits, jerky} for $20).
model Promotion {
  id             String   @id @default(cuid())
  // Admin-chosen topic/label shown on receipts, e.g. "Veterans Discount".
  name           String
  type           String   // "code" | "bundle"
  active         Boolean  @default(true)
  // code type
  code           String?  @unique
  percentOff     Int?     // 1..100
  // bundle type
  bundleQuantity Int?
  bundlePrice    Float?
  // JSON-encoded array of eligible product ids.
  productIds     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Small key/value store for admin-editable site content (e.g. the About
// page photos). Keys are whitelisted server-side.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Structured application events for the admin activity log: user logins
// (success/failure) and server errors. Written best-effort and also
// mirrored to stdout, so Docker logs and the in-app breakdown stay in
// sync. Retained in the DB for the dashboard's queries.
model LogEvent {
  id        String   @id @default(cuid())
  // "info" | "warn" | "error"
  level     String
  // "auth" | "error"
  category  String
  // e.g. "login_success", "login_failed", "login_unverified",
  // "server_error", "payment_error"
  event     String
  message   String
  // Associated user, when known.
  email     String?
  userId    String?
  // Request context for errors.
  path      String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([category, createdAt])
  @@index([event, createdAt])
}

// Messages sent through the public Contact Us form. Emailed to every
// admin and listed on the admin Messages page.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  // Set once an admin marks it read on the Messages page.
  readAt    DateTime?
  createdAt DateTime @default(now())
}

// Admin-uploaded images (product photos, About page), stored in the
// database so the app needs no persistent disk — Cloud Run's filesystem
// is ephemeral. Served via /api/uploads/[name] with immutable caching;
// the 5 MB cap is enforced by the upload route.
model Upload {
  name      String   @id
  mime      String
  data      Bytes
  createdAt DateTime @default(now())
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String
  location    String?
  // Calendar day of the event, stored as midnight UTC and compared by
  // YYYY-MM-DD key so it renders the same in every timezone.
  date        DateTime
  // Wall-clock hours at the event ("HH:MM", 24h, store-local time),
  // shown to customers. Pickup eligibility is a day-level rule (see
  // src/lib/pickup-window.js) — these times are display only.
  startTime   String?
  endTime     String?
  // Badge color key from the fixed palette, chosen by the admin.
  color       String   @default("teal")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  pickupOrders Order[]
}
