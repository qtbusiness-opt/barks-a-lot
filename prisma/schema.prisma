generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("customer")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String
  // Stock for products without variants; for products with variants the
  // stock lives on each variant and this stays 0.
  quantity    Int
  price       Float
  image       String
  category    String
  inStock     Boolean     @default(true)
  featured    Boolean     @default(false)
  // Limited/seasonal drops (e.g. holiday plushie "adoptions"):
  // limitedQuantity is the original batch size so the UI can show
  // "X of Y left"; sold-out limited items are hidden from listings.
  limitedQuantity Int?
  availableFrom   DateTime?
  availableUntil  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  variants    ProductVariant[]
  orderItems  OrderItem[]
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  name       String
  // JSON-encoded attribute tags (SQLite has no native JSON column), e.g.
  // {"flavor":"peanut butter","size":"large","dietary":["grain-free"]} for
  // treats or {"size":"medium","pattern":"plaid"} for bandanas — keeps
  // cart/inventory logic generic instead of hardcoding product types.
  attributes String?
  // null = inherit the product's base price
  price      Float?
  quantity   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orderItems OrderItem[]
}

model Order {
  id                 String      @id @default(cuid())
  confirmationNumber String      @unique
  userId             String?
  user               User?       @relation(fields: [userId], references: [id])
  guestEmail         String?
  guestName          String?
  status             String      @default("pending")
  // "online" (web checkout) | "market" (in-person sale recorded after the
  // fact) — one inventory ledger across both sales channels.
  channel            String      @default("online")
  // "shipping" | "pickup" — pickup orders (markets/expos) need no address.
  fulfillmentType    String      @default("shipping")
  // The market/expo the customer chose to pick up at.
  pickupEventId      String?
  pickupEvent        Event?      @relation(fields: [pickupEventId], references: [id])
  total              Float
  address            String?
  city               String?
  state              String?
  zip                String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  items              OrderItem[]
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id])
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int
  price     Float
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  // Admin who created it, for the audit trail.
  createdBy String
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  // Customer or guest email the notification is addressed to.
  email     String
  message   String
  orderId   String?
  createdAt DateTime @default(now())
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String
  location    String?
  // Calendar day of the event, stored as midnight UTC and compared by
  // YYYY-MM-DD key so it renders the same in every timezone.
  date        DateTime
  // Badge color key from the fixed palette, chosen by the admin.
  color       String   @default("teal")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  pickupOrders Order[]
}
